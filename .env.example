# For the local docker-compose stack (`docker compose up -d`), the defaults
# below work as-is. Point VAULT_ADDR/BW_* at real instances for production use.

BW_CLIENTID=
BW_CLIENTSECRET=
BW_PASSWORD=
# Only needed for a self-hosted server (e.g. the local Vaultwarden stack
# below); leave unset to use the official bitwarden.com.
BW_SERVER_URL=

VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root
VAULT_MOUNT=secret
VAULT_PATH_PREFIX=bitwarden

# docker-compose only (not read by bitwardensync itself)
VAULTWARDEN_ADMIN_TOKEN=admin
SEED_EMAIL=demo@example.com
SEED_PASSWORD=SeedMasterPassw0rd!123
SEED_NAME=Demo User
